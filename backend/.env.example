# SecureLens backend environment variables
# Copy to `.env` and fill in real values. Never commit the real .env.

# --- LLM (Groq) -------------------------------------------------------------
# Free-tier key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Database ---------------------------------------------------------------
# Local dev uses SQLite. On EC2, swap to e.g.
# postgresql+psycopg://user:pass@host:5432/securelens
DATABASE_URL=sqlite:///./securelens.db

# --- SonarQube --------------------------------------------------------------
SONARQUBE_HOST=http://localhost:9000
SONARQUBE_TOKEN=your_sonarqube_token_here

# --- RAG (ChromaDB + Ollama) ------------------------------------------------
CHROMA_DIR=./chroma
KNOWLEDGE_BASE_DIR=./knowledge_base
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
