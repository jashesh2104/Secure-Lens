# SecureLens backend environment variables
# Copy to `.env` and fill in real values. Never commit the real .env.

# --- LLM provider -----------------------------------------------------------
# Which chat backend powers triage + fix generation. GitHub Models was retired
# 2026-07-30, so the supported successors are any OpenAI-compatible endpoint.
#   openai -> OpenAI, Azure AI Foundry models endpoint, or a local server
#   azure  -> a classic Azure OpenAI deployment
#   groq   -> legacy fallback
LLM_PROVIDER=openai

# OpenAI-compatible (LLM_PROVIDER=openai). For Azure AI Foundry, set
# OPENAI_BASE_URL to your Foundry models endpoint and OPENAI_MODEL to the
# deployed model; for a local server (Ollama/vLLM), point OPENAI_BASE_URL there.
OPENAI_API_KEY=your_openai_or_foundry_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Classic Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your_deployment_name

# Legacy Groq fallback (LLM_PROVIDER=groq). Key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Database ---------------------------------------------------------------
# Local dev uses SQLite. On EC2, swap to e.g.
# postgresql+psycopg://user:pass@host:5432/securelens
DATABASE_URL=sqlite:///./securelens.db

# --- SonarQube --------------------------------------------------------------
SONARQUBE_HOST=http://localhost:9000
SONARQUBE_TOKEN=your_sonarqube_token_here

# --- RAG (ChromaDB + Ollama) ------------------------------------------------
CHROMA_DIR=./chroma
KNOWLEDGE_BASE_DIR=./knowledge_base
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
